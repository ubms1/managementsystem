NODE_ENV=production
PORT=3000

# MySQL — cPanel creates prefixed names: rushmedz_dbname
DB_HOST=localhost
DB_PORT=3306
DB_NAME=rushmedz_ubms
DB_USER=rushmedz_ubms_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# (Optional) JWT secret for future token auth
JWT_SECRET=CHANGE_ME_RANDOM_STRING_64_CHARS
