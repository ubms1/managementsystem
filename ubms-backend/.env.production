# ============================================================
#  UBMS Backend — Production Environment Variables
#  Copy this to .env on the GoManilaHost VPS:
#    cp .env.production .env
#  Then fill in the actual values below.
# ============================================================

NODE_ENV=production
PORT=3000

# MySQL — GoManilaHost cPanel database credentials
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ubms_database
DB_USER=ubms_dbuser
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# (Optional) JWT secret for future token auth
JWT_SECRET=CHANGE_ME_RANDOM_STRING_64_CHARS
